# ===============================================================
#  SLA Prediction (SARIMA / RF / LSTM) — .gitignore
# ===============================================================

# ---------------------------------------------------------------
# Virtual environment  (.venv ขนาด ~2.5 GB — ห้าม commit เด็ดขาด)
# ผู้อื่นสร้างใหม่ได้จาก requirements.txt
# ---------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipython/

# ---------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ---------------------------------------------------------------
# ไฟล์สำรอง (backup) — เก็บไว้ในเครื่องพอ ไม่ต้องเข้า git
# ประวัติเวอร์ชันให้ git ดูแลแทน
# ---------------------------------------------------------------
*.bak
*.bak_*
*.ipynb.bak*
*.orig

# ---------------------------------------------------------------
# ผลลัพธ์ที่โน้ตบุ๊กสร้างใหม่ได้ทุกครั้งที่ Run All
#
# ถ้าต้องการเก็บบางไฟล์เข้า git จริง ๆ (เช่น ตาราง/รูปที่ใช้ในเล่ม)
# บังคับเพิ่มทีละไฟล์ได้:
#     git add -f outputs_fair_comparison/final_metrics_3models.csv
# หรือถ้าอยากเก็บทั้งโฟลเดอร์ ให้ลบบรรทัดนั้นออกจากไฟล์นี้
# ---------------------------------------------------------------
outputs/
outputs_fair_comparison/
train_model_final/
models/

# ---------------------------------------------------------------
# ข้อมูลดิบ
# หมายเหตุ: Rawdata/ ปัจจุบันรวมกันแค่ ~2.8 MB จึง track ตามปกติ
#           เพื่อให้คนอื่น reproduce ผลได้ครบ
#           ถ้าภายหลังมีไฟล์ก้อนใหญ่ (>50 MB) ให้เพิ่ม path ตรงนี้
#           หรือย้ายไปใช้ Git LFS
# ---------------------------------------------------------------
*.zarr/
*.grib
*.grib2
*.nc.tmp
*.download

# ---------------------------------------------------------------
# TensorFlow / Keras
# ---------------------------------------------------------------
logs/
checkpoints/
*.h5
*.keras
*.tflite
*.pb
saved_model/

# ---------------------------------------------------------------
# ระบบปฏิบัติการ / โปรแกรมสำนักงาน
# ---------------------------------------------------------------
desktop.ini
Thumbs.db
ehthumbs.db
.DS_Store
*.tmp
~$*.xlsx
~$*.docx
~$*.pptx

# ---------------------------------------------------------------
# ความลับ / ค่าเฉพาะเครื่อง
# ---------------------------------------------------------------
.env
.env.local
*.key
*.pem
.cdsapirc

# ---------------------------------------------------------------
# VS Code — แชร์เฉพาะค่าที่ใช้ร่วมกันทั้งทีม
# ---------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---------------------------------------------------------------
# Claude Code — settings.json แชร์ได้ ส่วน settings.local.json เป็นของเฉพาะเครื่อง
# ---------------------------------------------------------------
.claude/settings.local.json

# Node (frontend tooling)
node_modules/
npm-debug.log*
